---
import Layout from "../layouts/Layout.astro";
import Container from "../components/site/Container.astro";
import PageHero from "../components/site/PageHero.astro";
import LinkedInIcon from "../components/site/LinkedInIcon.astro";
import foundersData from "../data/founders.json";
import { sitePath } from "../lib/site";

interface Founder {
  name: string;
  role: string;
  focus?: string;
  initials?: string;
  bio?: string;
  image?: string;
  linkedin?: string;
  expertise?: string[];
}

const founders: Founder[] = foundersData.founders;

const values = [
  {
    title: "Engineering Excellence",
    body: "We architect resilient, production-ready systems designed for real-world demands—prioritizing reliability, observability, and clean code over superficial demos.",
  },
  {
    title: "Pragmatic Innovation",
    body: "We apply modern AI and technology where it delivers measurable business value—prioritizing efficiency, accuracy, and ROI over industry hype.",
  },
  {
    title: "Trust & Transparency",
    body: "We build lasting partnerships through radical clarity in our timelines, architecture, and communication—ensuring no surprises from kickoff to launch.",
  },
  {
    title: "Client Partnership",
    body: "We work as an embedded extension of your team. Your objectives shape our roadmap, and our success is measured by the durable value and autonomy we deliver.",
  },
] as const;
---

<Layout
  title="About Us — Vedamit Solutions"
  description="We are dedicated to transforming businesses through innovative solutions."
  canonicalPath="/about"
>
  <section class="py-10 sm:py-13 lg:py-15">
    <Container wide>
      <PageHero
        badge="About"
        title="About Us"
        description="We are dedicated to transforming businesses through innovative solutions."
      />

      <div class="mx-auto mt-6 max-w-4xl space-y-12 sm:mt-10 sm:space-y-16">
        <!-- Unified Leadership Showcase (Top of page for instant visibility) -->
        <div
          class="rounded-2xl border border-border/60 bg-gradient-to-b from-card via-card to-muted/20 p-5 shadow-sm sm:rounded-3xl sm:p-8 lg:p-9"
        >
          <div
            class="flex flex-col gap-2 border-b border-border/60 pb-4 sm:flex-row sm:items-end sm:justify-between sm:gap-4 sm:pb-5"
          >
            <div>
              <p
                class="text-xs font-semibold uppercase tracking-[0.14em] text-primary"
              >
                Leadership
              </p>
              <h2
                class="font-heading mt-1 text-xl font-semibold tracking-tight text-foreground sm:text-2xl lg:text-3xl"
              >
                Meet Our Founders
              </h2>
            </div>
            <p
              class="text-xs leading-relaxed text-muted-foreground sm:max-w-md sm:text-right sm:text-sm"
            >
              Founded to harness the transformative power of AI and modern technology to empower growing businesses.
            </p>
          </div>

          <div
            class="mt-6 divide-y divide-border/60 sm:mt-8 lg:grid lg:grid-cols-2 lg:gap-12 lg:divide-y-0 lg:divide-x"
          >
            {
              founders.map((founder, index) => (
                <div
                  class:list={[
                    "flex flex-col justify-between",
                    index > 0
                      ? "pt-6 sm:pt-8 lg:pl-10 lg:pt-0"
                      : "pb-6 sm:pb-8 lg:pb-0 lg:pr-10",
                  ]}
                >
                  <div>
                    <div class="flex items-start justify-between gap-3 sm:gap-4">
                      <div class="flex min-w-0 items-center gap-3 sm:gap-4">
                        {founder.image ? (
                          <img
                            src={sitePath(founder.image)}
                            alt={founder.name}
                            class="size-12 shrink-0 rounded-2xl border border-border/60 object-cover shadow-sm sm:size-14"
                          />
                        ) : (
                          <div
                            class="flex size-12 shrink-0 items-center justify-center rounded-2xl border border-primary/25 bg-gradient-to-br from-primary/15 via-primary/5 to-transparent font-heading text-base font-bold tracking-tight text-primary shadow-sm sm:size-14 sm:text-lg"
                            aria-hidden="true"
                          >
                            {founder.initials ||
                              founder.name
                                .split(" ")
                                .map((n) => n[0])
                                .slice(0, 2)
                                .join("")}
                          </div>
                        )}
                        <div class="min-w-0">
                          <h3 class="font-heading text-base font-semibold tracking-tight text-foreground sm:text-lg lg:text-xl">
                            {founder.name}
                          </h3>
                          <p class="mt-0.5 text-xs font-semibold uppercase tracking-wider text-primary">
                            {founder.role}
                          </p>
                          {founder.focus && (
                            <p class="mt-0.5 text-xs text-muted-foreground">
                              {founder.focus}
                            </p>
                          )}
                        </div>
                      </div>

                      {founder.linkedin && (
                        <a
                          href={founder.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="shrink-0 rounded-lg p-1.5 text-muted-foreground transition hover:bg-muted hover:text-primary"
                          aria-label={`${founder.name} on LinkedIn`}
                        >
                          <LinkedInIcon class="size-4" />
                        </a>
                      )}
                    </div>

                    {founder.bio && (
                      <p class="mt-3.5 text-xs leading-relaxed text-muted-foreground sm:mt-4 sm:text-sm">
                        {founder.bio}
                      </p>
                    )}
                  </div>

                  {founder.expertise && founder.expertise.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-1.5 pt-2 sm:mt-5 sm:gap-2">
                      {founder.expertise.map((item) => (
                        <span class="inline-flex items-center rounded-md border border-border/50 bg-muted/50 px-2 py-0.5 text-[11px] font-medium text-muted-foreground sm:px-2.5 sm:py-1 sm:text-xs">
                          {item}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        <!-- Mission & Vision (Open Typography, No Box Cards) -->
        <div class="grid gap-8 sm:gap-10 md:grid-cols-2">
          <div>
            <h2
              class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
            >
              Our Mission
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:mt-4 sm:text-base">
              To engineer dependable, production-ready AI, intelligent automation,
              and scalable digital systems that solve complex operational challenges.
              We partner with modern teams to turn emerging technology into measurable,
              durable competitive advantages.
            </p>
          </div>

          <div>
            <h2
              class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
            >
              Our Vision
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground sm:mt-4 sm:text-base">
              To be a globally trusted engineering partner in applied AI and resilient
              enterprise technology. We envision a future where intelligent systems
              seamlessly empower organizations—amplifying human capability, accelerating
              decisions, and setting new benchmarks for digital excellence.
            </p>
          </div>
        </div>

        <!-- Core Values -->
        <div>
          <h2
            class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
          >
            Our Core Values
          </h2>
          <p class="mt-2 text-sm text-muted-foreground sm:mt-3 sm:text-base">
            The principles that guide our engineering culture, client relationships, and architectural standards
          </p>
          <div class="mt-6 grid gap-4 sm:mt-8 sm:grid-cols-2 sm:gap-5">
            {
              values.map((v) => (
                <article class="rounded-2xl border border-border/60 bg-card p-5 shadow-sm transition hover:border-primary/20 sm:p-7">
                  <h3 class="text-base font-semibold tracking-tight">
                    {v.title}
                  </h3>
                  <p class="mt-2.5 text-xs leading-relaxed text-muted-foreground sm:mt-3 sm:text-sm">
                    {v.body}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </Container>
  </section>
</Layout>
