---
import Layout from "../layouts/Layout.astro";
import Container from "../components/site/Container.astro";
import PageHero from "../components/site/PageHero.astro";
import LinkedInIcon from "../components/site/LinkedInIcon.astro";
import foundersData from "../data/founders.json";
import { sitePath } from "../lib/site";

interface Founder {
  name: string;
  role: string;
  focus?: string;
  initials?: string;
  bio?: string;
  image?: string;
  linkedin?: string;
  expertise?: string[];
}

const founders: Founder[] = foundersData.founders;

const values = [
  {
    title: "Excellence",
    body: "We strive for excellence in everything we do, delivering the highest quality solutions and services to our clients.",
  },
  {
    title: "Innovation",
    body: "We continuously push the boundaries of what's possible, embracing new technologies and approaches to solve complex challenges.",
  },
  {
    title: "Trust",
    body: "We build and maintain trust through transparency, reliability, and consistent delivery of exceptional results.",
  },
  {
    title: "Client Success",
    body: "We are committed to our clients' success, working as true partners to achieve their business objectives.",
  },
] as const;
---

<Layout
  title="About Us — Vedamit Solutions"
  description="We are a team of AI and technology experts dedicated to transforming businesses through innovative solutions."
  canonicalPath="/about"
>
  <section class="py-10 sm:py-13 lg:py-15">
    <Container wide>
      <PageHero
        badge="About"
        title="About Us"
        description="We are a team of AI and technology experts dedicated to transforming businesses through innovative solutions."
      />

      <div class="mx-auto mt-14 max-w-4xl space-y-16">
        <!-- Unified Leadership Showcase -->
        <div
          class="rounded-3xl border border-border/60 bg-gradient-to-b from-card via-card to-muted/20 p-7 shadow-sm sm:p-9 lg:p-11"
        >
          <div class="max-w-3xl">
            <p
              class="text-xs font-semibold uppercase tracking-[0.14em] text-primary"
            >
              Founding Leadership
            </p>
            <h2
              class="font-heading mt-2 text-2xl font-semibold tracking-tight sm:text-3xl"
            >
              Meet Our Founders
            </h2>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">
              Vedamit Solutions was established under the visionary leadership
              of our co-founders, dedicated to harnessing the transformative
              power of Artificial Intelligence and modern technology to uplift
              small and medium-sized enterprises (SMEs).
            </p>
          </div>

          <div
            class="mt-10 grid gap-8 divide-y divide-border/60 border-t border-border/60 pt-8 lg:grid-cols-2 lg:gap-12 lg:divide-y-0 lg:divide-x"
          >
            {
              founders.map((founder, index) => (
                <div
                  class:list={[
                    "flex flex-col justify-between",
                    index > 0 ? "pt-8 lg:pl-10 lg:pt-0" : "lg:pr-10",
                  ]}
                >
                  <div>
                    <div class="flex items-start justify-between gap-4">
                      <div class="flex items-center gap-4">
                        {founder.image ? (
                          <img
                            src={sitePath(founder.image)}
                            alt={founder.name}
                            class="size-14 rounded-2xl border border-border/60 object-cover shadow-sm"
                          />
                        ) : (
                          <div
                            class="flex size-14 shrink-0 items-center justify-center rounded-2xl border border-primary/25 bg-gradient-to-br from-primary/15 via-primary/5 to-transparent font-heading text-lg font-bold tracking-tight text-primary shadow-sm"
                            aria-hidden="true"
                          >
                            {founder.initials ||
                              founder.name
                                .split(" ")
                                .map((n) => n[0])
                                .slice(0, 2)
                                .join("")}
                          </div>
                        )}
                        <div>
                          <h3 class="font-heading text-lg font-semibold tracking-tight text-foreground sm:text-xl">
                            {founder.name}
                          </h3>
                          <p class="mt-0.5 text-xs font-semibold uppercase tracking-wider text-primary">
                            {founder.role}
                          </p>
                          {founder.focus && (
                            <p class="text-xs text-muted-foreground">
                              {founder.focus}
                            </p>
                          )}
                        </div>
                      </div>

                      {founder.linkedin && (
                        <a
                          href={founder.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="rounded-lg p-1.5 text-muted-foreground transition hover:bg-muted hover:text-primary"
                          aria-label={`${founder.name} on LinkedIn`}
                        >
                          <LinkedInIcon class="size-4" />
                        </a>
                      )}
                    </div>

                    {founder.bio && (
                      <p class="mt-5 text-sm leading-relaxed text-muted-foreground">
                        {founder.bio}
                      </p>
                    )}
                  </div>

                  {founder.expertise && founder.expertise.length > 0 && (
                    <div class="mt-6 flex flex-wrap gap-2 pt-4">
                      {founder.expertise.map((item) => (
                        <span class="inline-flex items-center rounded-md border border-border/50 bg-muted/50 px-2.5 py-1 text-xs font-medium text-muted-foreground">
                          {item}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        <!-- Mission & Vision (Open Typography, No Box Cards) -->
        <div class="grid gap-10 md:grid-cols-2">
          <div>
            <h2
              class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
            >
              Our Mission
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
              To empower businesses with cutting-edge AI solutions that drive
              innovation, efficiency, and growth. We are committed to delivering
              transformative technology that helps our clients stay ahead in the
              digital age.
            </p>
          </div>

          <div>
            <h2
              class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
            >
              Our Vision
            </h2>
            <p class="mt-4 text-base leading-relaxed text-muted-foreground">
              To be the leading force in AI-driven business transformation,
              recognized globally for our innovative solutions and commitment to
              client success. We envision a future where AI technology makes
              businesses more efficient, intelligent, and sustainable.
            </p>
          </div>
        </div>

        <!-- Core Values -->
        <div>
          <h2
            class="font-heading text-xl font-semibold tracking-tight sm:text-2xl"
          >
            Our Core Values
          </h2>
          <p class="mt-3 text-base text-muted-foreground">
            The principles that guide our work and relationships
          </p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2">
            {
              values.map((v) => (
                <article class="rounded-2xl border border-border/60 bg-card p-7 shadow-sm transition hover:border-primary/20">
                  <h3 class="text-base font-semibold tracking-tight">
                    {v.title}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                    {v.body}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </Container>
  </section>
</Layout>
