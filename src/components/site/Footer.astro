---
import Container from "./Container.astro";
import LinkedInIcon from "./LinkedInIcon.astro";
import { sitePath } from "../../lib/site";
import contactData from "../../data/contact.json";
---

<footer class="relative border-t border-border/60 bg-card/30">
  <Container wide class="py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="space-y-4 lg:max-w-sm">
        <div class="inline-flex items-center gap-2">
          <picture>
            <source srcset={sitePath("/logo.avif")} type="image/avif" />
            <img
              src={sitePath("/logo.png")}
              alt="Vedamit Solutions logo"
              class="h-15 w-auto grayscale-[100%] brightness-50"
              width="1280"
              height="397"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <p class="text-sm leading-relaxed text-muted-foreground">
          AI, automation, and full‑stack engineering for teams that want clear
          metrics, fast iteration, and production‑grade delivery.
        </p>
      </div>

      <div class="space-y-4">
        <div
          class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground"
        >
          Navigate
        </div>
        <ul class="space-y-3 text-sm">
          <li>
            <a
              class="text-foreground/90 transition-colors hover:text-primary"
              href={sitePath("/services")}>Services</a
            >
          </li>
          <li>
            <a
              class="text-foreground/90 transition-colors hover:text-primary"
              href={sitePath("/case-studies")}>Case studies</a
            >
          </li>
          <li>
            <a
              class="text-foreground/90 transition-colors hover:text-primary"
              href={sitePath("/about")}>About</a
            >
          </li>
          <li>
            <a
              class="text-foreground/90 transition-colors hover:text-primary"
              href={sitePath("/contact")}>Contact</a
            >
          </li>
        </ul>
      </div>

      <div class="space-y-4">
        <div
          class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground"
        >
          Visit
        </div>
        <ul class="space-y-3 text-sm text-muted-foreground">
          {contactData.location && <li class="leading-snug">{contactData.location}</li>}
          {contactData.phone && (
            <li>
              <a
                class="text-foreground/90 transition-colors hover:text-primary"
                href={`tel:${contactData.phone.replace(/[^0-9+]/g, '')}`}>{contactData.phone}
              </a>
            </li>
          )}
          {contactData.email && (
            <li>
              <a
                class="break-all text-foreground/90 transition-colors hover:text-primary"
                href={`mailto:${contactData.email}`}
                >{contactData.email}</a
              >
            </li>
          )}
        </ul>
      </div>

      {contactData.linkedin && (
        <div class="space-y-4">
          <div
            class="text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground"
          >
            Social
          </div>
          <a
            class="inline-flex items-center gap-2 text-sm text-foreground/90 transition-colors hover:text-primary"
            href={contactData.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            <LinkedInIcon class="size-4 shrink-0 opacity-90" />
            Vedamit Solutions
          </a>
        </div>
      )}
    </div>

    <div
      class="mt-14 flex items-center justify-center border-t border-border/60 pt-8"
    >
      <p class="text-center text-xs text-muted-foreground">
        © 2026 Vedamit Solutions. All rights reserved.
      </p>
    </div>
  </Container>
</footer>
